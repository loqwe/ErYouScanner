<ui version="4.0">
 <class>WindowMain</class>
 <widget class="QMainWindow" name="WindowMain">
  <property name="geometry"><rect><x>0</x><y>0</y><width>660</width><height>620</height></rect></property>
  <property name="minimumSize"><size><width>620</width><height>560</height></size></property>
  <property name="font"><font><family>Microsoft YaHei</family><pointsize>9</pointsize></font></property>
  <property name="windowTitle"><string>ErYouScanner</string></property>
  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralWidget { background: #f5f6f7; color: #24272b; }
QLabel { color: #24272b; }
QCheckBox { color: #24272b; spacing: 6px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #c6cbd0; border-radius: 4px; background: #ffffff; }
QCheckBox::indicator:hover { border-color: #087e72; background: #f0fdfa; }
QCheckBox::indicator:checked { background-color: #087e72; border-color: #087e72; image: url(:/icons/check.png); }
QCheckBox::indicator:disabled { background-color: #edf0f2; border-color: #d6dade; }

QLineEdit, QDoubleSpinBox, QSpinBox {
 background: #ffffff; color: #24272b; border: 1px solid #c6cbd0;
 border-radius: 6px; padding: 4px 8px; selection-background-color: #087e72;
}
QLineEdit[readOnly="true"] { background: #edf0f2; }
QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus { border-color: #087e72; }
QLineEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled { background: #edf0f2; color: #747b82; }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
 width: 0px; height: 0px; border: none;
}

QComboBox {
 background: #ffffff; color: #24272b; border: 1px solid #c6cbd0;
 border-radius: 6px; padding: 4px 24px 4px 8px; selection-background-color: #087e72;
}
QComboBox:hover { background: #f7f9fa; border-color: #087e72; }
QComboBox:focus { border-color: #087e72; }
QComboBox:disabled { background: #edf0f2; color: #747b82; border-color: #d6dade; }
QComboBox::drop-down {
 subcontrol-origin: padding;
 subcontrol-position: top right;
 width: 22px;
 border-left-width: 0px;
}
QComboBox::down-arrow {
 image: url(:/icons/chevron_down.png);
 width: 10px;
 height: 10px;
}
QComboBox QAbstractItemView {
 background: #ffffff; color: #24272b; border: 1px solid #d3d8dd; border-radius: 6px;
 padding: 4px; outline: none; selection-background-color: #e1f1ed; selection-color: #175d52;
}
QComboBox QAbstractItemView::item { height: 26px; padding: 2px 8px; border-radius: 4px; }
QComboBox QAbstractItemView::item:hover { background: #f0f2f5; color: #175d52; }

QPushButton { background: #ffffff; color: #24272b; border: 1px solid #b9c0c5; border-radius: 6px; padding: 6px 12px; font-weight: 500; }
QPushButton:hover { background: #edf5f3; border-color: #087e72; color: #087e72; }
QPushButton:pressed, QPushButton:checked { background: #087e72; border-color: #087e72; color: #ffffff; font-weight: bold; }
QPushButton:focus { border: 2px solid #087e72; padding: 5px 11px; }
QPushButton:disabled { background: #edf0f2; color: #747b82; border-color: #d6dade; }

QTableWidget { background: #ffffff; alternate-background-color: #f8fafb; color: #24272b; border: 1px solid #d3d8dd; border-radius: 6px; gridline-color: transparent; }
QTableWidget::item { padding: 6px 4px; border-bottom: 1px solid #f0f2f5; }
QTableWidget::item:selected { background: #e1f1ed; color: #175d52; font-weight: 500; }
QHeaderView::section { background: #edf0f2; color: #454d55; padding: 7px 4px; font-weight: 600; border: none; border-bottom: 1px solid #d3d8dd; }

QMenuBar { background: #f5f6f7; color: #24272b; }
QMenuBar::item { padding: 6px 12px; border-radius: 4px; }
QMenuBar::item:selected { background: #e1f1ed; }
QMenu { background: #ffffff; color: #24272b; border: 1px solid #d3d8dd; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 4px 16px; border-radius: 4px; }
QMenu::item:selected { background: #e1f1ed; color: #175d52; }
QLabel#label_3, QLabel#label_2, QLabel#label_4 { color: #626b73; }
QLabel#labelConfirmDelayHelp, QLabel#labelScanIntervalHelp {
 background: transparent;
 border: none;
 image: url(:/icons/help_outline.png);
}
QLabel#labelConfirmDelayHelp:hover, QLabel#labelScanIntervalHelp:hover {
 image: url(:/icons/help_outline_hover.png);
}
QToolTip {
 background-color: #1e293b;
 color: #ffffff;
 border: 1px solid #334155;
 border-radius: 6px;
 padding: 6px 10px;
 font-family: "Microsoft YaHei", sans-serif;
 font-size: 12px;
}
QFrame#footerSeparator { color: #d3d8dd; }</string>
